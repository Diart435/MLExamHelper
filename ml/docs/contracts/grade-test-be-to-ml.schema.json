{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-exam:contract:grade-test:be-to-ml",
  "title": "Задача проверки попытки — канал grade-test:be-to-ml",
  "type": "object",
  "required": [
    "task_id",
    "attempt_id",
    "test_id",
    "answers"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "student_answer"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "student_answer": {
            "$ref": "#/$defs/student_answer"
          }
        }
      }
    }
  },
  "$defs": {
    "student_answer": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "index"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "indexes"
          ],
          "properties": {
            "indexes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "task_id": "2b8e4c31-6d7a-4f19-a503-9e8c1b4d6f27",
      "attempt_id": "4d8f2b76-1e35-4c9a-b027-8f6a3d1e5b42",
      "test_id": "9e3a6d52-8c14-47b0-a2f6-1d8e5c3b4a90",
      "answers": [
        {
          "question_id": "18c5e91a-2d74-4f60-b839-7e1a5c0d6b42",
          "student_answer": {
            "index": 1
          }
        },
        {
          "question_id": "7a0d3e91-c642-4f88-b125-6d9e2a4c8f31",
          "student_answer": {
            "indexes": [
              0,
              1,
              2
            ]
          }
        },
        {
          "question_id": "c30e8f2a-4b19-4d77-a810-6f3b9c2e5d04",
          "student_answer": {
            "text": "Транзакция обеспечивает атомарность операций."
          }
        }
      ]
    }
  ]
}
