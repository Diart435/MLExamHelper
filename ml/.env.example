# LLM / Embeddings (через OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=minimax/minimax-m3:free
EMBED_MODEL=openai/text-embedding-3-small
BASE_URL=https://openrouter.ai/api/v1

# Postgres. ML пишет только material_chunks, читает test_questions.
DATABASE_URL=postgresql://ml:ml@localhost:5432/ml
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# Redis Streams. Тип задачи задаёт ИМЯ СТРИМА, поле type не передаётся.
REDIS_URL=redis://localhost:6379/0
STREAM_TASKS_INGEST=ml:tasks:ingest
STREAM_TASKS_CREATE_TEST=ml:tasks:create-test
STREAM_TASKS_GRADE_ATTEMPT=ml:tasks:grade-attempt
STREAM_RESULTS_INGEST=ml:results:ingest
STREAM_RESULTS_CREATE_TEST=ml:results:create-test
STREAM_RESULTS_GRADE_ATTEMPT=ml:results:grade-attempt
CONSUMER_GROUP=ml-workers
CONSUMER_NAME=worker-1
WORKER_CLAIM_IDLE_MS=30000

# S3 (seaweedfs / MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=materials
MINIO_SECURE=false

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CONTEXT_CHUNKS=12

LOG_LEVEL=INFO