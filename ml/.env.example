# LLM / Embeddings (через RouterAI)
# Имя переменной историческое (осталось от OpenRouter) — провайдер теперь
# RouterAI, OpenAI-совместимый шлюз. Ключ берётся из OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-your-routerai-key-here
LLM_MODEL=minimax/minimax-m3:free
EMBED_MODEL=openai/text-embedding-3-small
BASE_URL=https://routerai.ru/api/v1

# Postgres. ML пишет только material_chunks, читает test_questions.
DATABASE_URL=postgresql://ml:ml@localhost:5432/ml
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4

# Redis Streams. Тип задачи задаёт ИМЯ СТРИМА, поле type не передаётся.
# Имена каналов заданы в app/contracts.py и не конфигурируются.
REDIS_URL=redis://localhost:6379/0

# Имя consumer'а по умолчанию берётся из hostname машины (socket.gethostname()),
# в docker у каждого контейнера своё — поэтому оно не фиксируется.
# CONSUMER_NAME в env — только способ переопределить дефолт.
# Обязателен только CONSUMER_GROUP.
CONSUMER_GROUP=ml-workers
WORKER_CLAIM_IDLE_MS=30000
WORKER_CLAIM_INTERVAL_MS=60000
WORKER_CLAIM_MAX_ATTEMPTS=5

# S3 (seaweedfs / MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_user
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=materials
MINIO_SECURE=false

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CONTEXT_CHUNKS=12

LOG_LEVEL=INFO

# Подробные логи LLM: полные промпты, JSON-схемы и сырые ответы модели
# в docker logs ml. true (по умолчанию) — видно всё; false — только
# обычные INFO-строки.
LOG_LLM_PAYLOADS=true